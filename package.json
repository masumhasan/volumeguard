{
  "name": "volume-guard",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension that keeps movie and TV volume at the level you choose.",
  "type": "module",
  "scripts": {
    "build": "node init && node scripts/build.mjs",
    "dev": "node init && node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "package": "node scripts/package.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.65.1",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
